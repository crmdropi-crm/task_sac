# ───────────────────────────────────────────────────────────────
# task_sac — variables de entorno (ejemplo)
# Copia este archivo a .env y completa los valores.
# NUNCA subas tu .env real al repositorio.
# ───────────────────────────────────────────────────────────────

# Entorno de ejecución: development | production | test
NODE_ENV=development

# Puerto donde escucha Express (sirve API + frontend estático en producción)
PORT=3000

# ── Base de datos (PostgreSQL) ──────────────────────────────────
# Local (docker-compose incluido): usa el servicio "db"
DATABASE_URL="postgresql://task_user:task_password@localhost:5432/task_sac?schema=public"
#
# En la VPS / Easypanel (red interna, host del servicio Postgres):
# DATABASE_URL="postgresql://task_user:SUPER_SECRETO@n8n_postgres:5432/task_sac?schema=public"

# ── Seguridad / sesión ──────────────────────────────────────────
# Clave para firmar los JWT de sesión. Genera una larga y aleatoria:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambia-esto-por-una-clave-larga-y-aleatoria"

# Duración de la sesión (formato de la librería ms, p. ej. 8h, 1d, 7d)
SESSION_TTL=8h

# Nombre de la cookie de sesión
COOKIE_NAME=task_sac_session

# true en producción detrás de HTTPS (cookie Secure). En local déjalo en false.
COOKIE_SECURE=false

# Orígenes permitidos para CORS en desarrollo (coma-separados).
# En producción el frontend se sirve desde el mismo origen, así que puede ir vacío.
CORS_ORIGINS=http://localhost:5173

# ── Administrador inicial (seed) ────────────────────────────────
# Al primer arranque, si no hay usuarios, se crea este admin.
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=CambiaEstaClave123
ADMIN_NAME=Administrador
ADMIN_CARGO=Administración

# ── Zona horaria para fechas ────────────────────────────────────
TZ=America/Bogota
